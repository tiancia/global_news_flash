# Common overrides only. Full options/defaults: src/main/resources/application.yml
# java -jar does NOT load .env. Supply process/IDE environment variables.
# Docker Compose reads .env for interpolation; unset overrides use application defaults.
# Keep secrets empty in this tracked example. Restart after changing configuration.

# Local startup defaults to OFFLINE. For manual collection use the mysql,live profiles.
# NEWS_RUNTIME_MODE=LIVE
# NEWS_EXTERNAL_ENABLED=true
NEWS_OPS_TOKEN=

# Base default: openai. The live profile defaults to deepseek.
# NEWS_AI_PROVIDER=deepseek
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Models, prices, API endpoints and timeouts are configured in application.yml.
# Change the model and both prices together. No automatic provider fallback.

NEWS_TELEGRAM_BOT_TOKEN=
# NEWS_TELEGRAM_CHAT_ID=-1004482990261
# Independent switches; enabling them does not release the persisted global pause.
NEWS_AUTOMATION_ENABLED=false
NEWS_TELEGRAM_ENABLED=false
NEWS_PUBLICATION_WORKER_ENABLED=false
NEWS_DIGEST_ENABLED=false
NEWS_ALERT_ENABLED=false

# Source approval and operating policy: docs/configuration.md.
# live supplies the reviewed Fed source, a batch size of 1 and policy-ready=true.
# NEWS_POLICY_READY=false
# NEWS_RSS_FEEDS_JSON=[]
# NEWS_ALERT_WEBHOOK_URL=
# NEWS_ALERT_WEBHOOK_TOKEN=

# Local MySQL defaults are in application-mysql.yml and compose.yml.
# NEWS_DB_PASSWORD=123456
# NEWS_DB_ROOT_PASSWORD=123456
