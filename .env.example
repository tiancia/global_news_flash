# Reference only. The application reads process/container environment variables.
# This file and .env are NOT loaded automatically by java -jar.
# Leave secrets empty here; supply them in your own environment.
# For the initial manual Fed collection, use the mysql,live profiles instead.
# application-live.yml supplies the non-secret setup defaults; values below override them.

NEWS_RUNTIME_MODE=LIVE
NEWS_EXTERNAL_ENABLED=false
NEWS_OPS_TOKEN=
NEWS_BIND_ADDRESS=127.0.0.1
NEWS_PORT=8090

# OpenAI Responses API: secrets come from the environment; model/prices default in application.yml.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional overrides only. Normally change all three together in application.yml instead.
# USD millionths per ONE MILLION tokens. Zero is invalid, not a request for the default.
# OPENAI_MODEL=gpt-6-luna
# NEWS_OPENAI_INPUT_MICROS_PER_MILLION_TOKENS=100000
# NEWS_OPENAI_OUTPUT_MICROS_PER_MILLION_TOKENS=500000
NEWS_OPENAI_TIMEOUT=45s
NEWS_OPENAI_MAX_INPUT_CHARACTERS=24000
NEWS_OPENAI_MAX_OUTPUT_TOKENS=1800

# One channel only. Start with the numeric id of your PRIVATE TEST channel (-100...).
NEWS_TELEGRAM_BOT_TOKEN=
# Private test channel defaults in application.yml; optional override only.
# NEWS_TELEGRAM_CHAT_ID=-1004482990261
NEWS_TELEGRAM_ENABLED=false
NEWS_TELEGRAM_CONNECT_TIMEOUT=5s
NEWS_TELEGRAM_REQUEST_TIMEOUT=15s

# Enable after reviewing the initial operating parameters. All USD amounts use millionths.
NEWS_POLICY_READY=false
NEWS_POLICY_VERSION=initial-v1
NEWS_MAX_AGE=12h
NEWS_MAX_CHARACTERS=3000
NEWS_ALLOWED_TOPICS=EARTHQUAKE,OFFICIAL_ANNOUNCEMENT,WORLD,ECONOMY,SCIENCE,TECHNOLOGY
NEWS_MINIMUM_INDEPENDENT_CHAINS=1
NEWS_DAILY_BUDGET_MICROS=1000000
NEWS_DAILY_REQUESTS=100
NEWS_AUTOMATION_ENABLED=false
NEWS_AUTOMATION_DELAY_MS=60000
NEWS_AUTOMATION_INITIAL_DELAY_MS=10000
NEWS_AUTOMATION_BATCH_SIZE=10
NEWS_EDITOR_JOB_LEASE=3m
NEWS_CYCLE_LEASE=15m
# HOLD keeps revisions for review; explicit alternatives: EDIT, UPDATE, CORRECTION.
NEWS_REVISION_MODE=HOLD

NEWS_INGESTION_ENABLED=false
NEWS_INGESTION_POLL_DELAY_MS=60000
NEWS_SOURCE_POLL_INTERVAL_MS=300000
NEWS_MAX_ITEMS_PER_SOURCE=20
NEWS_MAX_SOURCES_PER_POLL=10
NEWS_SOURCE_REQUEST_TIMEOUT_SECONDS=15
NEWS_SOURCE_MAX_RESPONSE_BYTES=1000000
NEWS_SOURCE_LEASE_SECONDS=900
NEWS_INBOX_LEASE_SECONDS=900
NEWS_MAX_PENDING_ITEMS=2000
# Leave room for source IDs, facts, URLs and JSON metadata within the OpenAI input limit.
NEWS_MAX_BODY_CHARACTERS=16000
NEWS_MINIMUM_BODY_CHARACTERS=200

# Every real source needs separate enablement, approval, license record and producer allowlist.
# No source is approved merely by this example. Set licenseVersion to your reviewed permission record.
NEWS_USGS_ENABLED=false
NEWS_USGS_APPROVED=false
NEWS_USGS_LICENSE_VERSION=pending
# Select producers admitted for the feed you chose; do not assume "us" covers all USGS networks.
NEWS_USGS_PERMITTED_PRODUCERS=
NEWS_USGS_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_day.geojson
NEWS_FED_ENABLED=false
NEWS_FED_APPROVED=false
NEWS_FED_LICENSE_VERSION=pending
NEWS_FED_PERMITTED_PRODUCERS=federal-reserve-board
NEWS_FED_URL=https://www.federalreserve.gov/feeds/press_all.xml
NEWS_FED_ARTICLE_SELECTOR=#article
# JSON array; see README for a complete RSS/Atom source contract. No secrets belong in feed URLs.
NEWS_RSS_FEEDS_JSON=[]
# Discovery only: GDELT materials never become evidence merely by enabling this source.
NEWS_GDELT_ENABLED=false
NEWS_GDELT_APPROVED=false
NEWS_GDELT_LICENSE_VERSION=pending
NEWS_GDELT_PERMITTED_PRODUCERS=
NEWS_GDELT_URL=

# Optional faster publication worker. The main automation cycle also drains the queue.
NEWS_PUBLICATION_WORKER_ENABLED=false
NEWS_PUBLICATION_WORKER_DELAY_MS=5000
NEWS_PUBLICATION_LEASE=2m
NEWS_PUBLICATION_MAX_ATTEMPTS=3
NEWS_PUBLICATION_MAX_PER_HOUR=6
NEWS_PUBLICATION_MAX_PER_DAY=24
NEWS_PUBLICATION_MINIMUM_INTERVAL=5m

NEWS_DIGEST_ENABLED=false
NEWS_DIGEST_UTC_HOUR=22
NEWS_DIGEST_MAX_ITEMS=5
NEWS_DIGEST_MAX_CHARACTERS=3000

# Optional HTTPS endpoint receiving generic JSON alert events; delivery is at least once.
NEWS_ALERT_ENABLED=false
NEWS_ALERT_WEBHOOK_URL=
NEWS_ALERT_WEBHOOK_TOKEN=
NEWS_ALERT_TIMEOUT=10s
NEWS_ALERT_DELAY_MS=60000

# Dedicated MySQL profile only. The default offline profile uses a local H2 file.
# Non-secret connection defaults are in application-mysql.yml; optional overrides only.
# NEWS_DB_URL=jdbc:mysql://127.0.0.1:3307/global_news_flash?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC
# NEWS_DB_USER=global_news_flash
# Local development defaults to 123456 for both accounts; optional overrides only.
# NEWS_DB_PASSWORD=123456
# Root is used for database administration; Spring Boot connects as global_news_flash.
# NEWS_DB_ROOT_PASSWORD=123456
